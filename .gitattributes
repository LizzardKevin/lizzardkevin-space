* text=auto eol=lf

# Windows launchers are easier to double-click with CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF on macOS/Linux/Git Bash.
*.sh text eol=lf
*.command text eol=lf

